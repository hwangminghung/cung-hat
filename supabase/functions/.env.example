GOOGLE_PLACES_API_KEY=your-google-places-key
PLACES_INGEST_SECRET=dev-secret
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
# thieu/rong -> push-fanout fail-closed 503
PUSH_FANOUT_SECRET=
GOOGLE_FCM_SA_JSON=your-fcm-service-account-json
# Standard Webhooks secret cua GoTrue send-sms hook (dang v1,whsec_...)
SEND_SMS_HOOK_SECRET=
# Provider SMS: 'esms' (eSMS.vn) hoac 'twilio'. Bo trong / ten la -> send-sms
# fail-closed 503 sau khi verify chu ky (KHONG BAO GIO tra 2xx gia).
SMS_PROVIDER=
# API key cua provider; voi twilio day la Auth Token
SMS_API_KEY=
# eSMS: can them SecretKey + brandname DA DUOC DUYET (xem plan operator-gates G1)
ESMS_SECRET_KEY=
SMS_BRANDNAME=
# Twilio (chi de test/du phong — gui dau so VN hay bi chan brandname)
TWILIO_ACCOUNT_SID=
TWILIO_FROM=
# Template tin nhan, '{otp}' la cho dien ma. Brandname VN phai dang ky truoc
# template voi nha mang — sua o day cho khop, dung sua trong code.
SMS_TEMPLATE=
# MoMo (sandbox endpoint: https://test-payment.momo.vn, prod: https://payment.momo.vn)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=
# ZaloPay (sandbox endpoint: https://sb-openapi.zalopay.vn, prod: https://openapi.zalopay.vn)
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT=
# Chung
PAYMENTS_REDIRECT_URL=
PAYMENTS_WEBHOOK_URL=
# IAP
APP_BUNDLE_ID=
APPLE_ENVIRONMENT=Sandbox
# numeric App Store app id (bat buoc khi APPLE_ENVIRONMENT=Production)
APPLE_APP_APPLE_ID=
APPLE_SHARED_SECRET=
ANDROID_PACKAGE_NAME=
GOOGLE_PLAY_SA_JSON=
